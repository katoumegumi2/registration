# Salin ke .env lalu ganti semua nilai rahasia.
# Port Nginx di host. APP_URL dan S3_PUBLIC_ENDPOINT harus memakai alamat dan port yang sama.
HTTP_PORT=8080
APP_URL=http://localhost:8080
# 32 byte acak dalam hex: openssl rand -hex 32
APP_KEY=
RUN_WORKER=true

POSTGRES_USER=pendaftaran
POSTGRES_PASSWORD=
POSTGRES_DB=pendaftaran
# Untuk menjalankan bun dari host. Di dalam container, compose menggantinya ke host "postgres".
DATABASE_URL=postgres://pendaftaran:GANTI@127.0.0.1:55432/pendaftaran

# s3 = RustFS, local = disk (rencana cadangan, PRD 6.6)
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=./storage-local
# Untuk dari host. Di dalam container, compose menggantinya ke http://rustfs:9000
S3_ENDPOINT=http://127.0.0.1:59000
S3_PUBLIC_ENDPOINT=http://localhost:8080
S3_REGION=us-east-1
S3_BUCKET=pendaftaran-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Dipakai bila pengaturan email di panel admin belum diisi.
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Panitia Pendaftaran <panitia@pendaftaran.local>

SEED_ADMIN_PASSWORD=
