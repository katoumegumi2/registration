upstream api_upstream {
    zone api_upstream 64k;
    server api:3000 resolve;
}

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    # Berkas: path-style bucket lewat origin aplikasi (PRD 6.6).
    location /${S3_BUCKET}/ {
        client_max_body_size 6m;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        # $http_host mempertahankan nomor port; tanda tangan presigned mengikat host + port.
        proxy_set_header Host $http_host;
        proxy_pass http://rustfs:9000;
        add_header X-Content-Type-Options nosniff always;
    }

    location /api/v1/uploads/ {
        client_max_body_size 6m;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://api_upstream;
    }

    location / {
        client_max_body_size 1m;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://api_upstream;
    }
}
