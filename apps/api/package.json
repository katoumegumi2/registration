{
  "name": "@pendaftaran/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/scripts/migrate.ts",
    "db:seed": "bun --env-file=../../.env src/scripts/seed.ts",
    "storage:init": "bun --env-file=../../.env src/scripts/init-storage.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test --timeout 60000"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.0.0",
    "@pendaftaran/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.0",
    "drizzle-orm": "^0.44.0",
    "exceljs": "^4.4.0",
    "hono": "^4.7.0",
    "nodemailer": "^7.0.0",
    "postgres": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^7.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0"
  }
}
